# ============================================================================
# Template for judge-deployment/.env — copy to .env and fill in the secrets.
#   cp .env.example .env
# Container-network addresses (kafka:29092) — keep as-is unless you rename services.
# Each service's database settings live in its own file: .env.identity, .env.problem, .env.submission
# (see the matching .example files).
# ============================================================================

# ---- spring profile (submission-service, api-gateway) ----
# "prod" runs submission-service against Postgres with ddl-auto=validate and swagger disabled.
SPRING_PROFILES_ACTIVE=prod

# ---- shared judge-server auth/token (api, worker, judge-server all agree) ----
# Required: the worker refuses to start without it. The sandboxes' URLs are fixed in docker-compose.yml (judge-worker's
# JUDGE_SERVER_URL, https: the worker presents its certificate).
JUDGE_SERVER_TOKEN=change-me

# ---- kafka (internal KRaft listener) ----
KAFKA_BROKERS=kafka:29092

# ---- redis (verdict SSE fan-out across submission-service instances) ----
REDIS_HOST=redis
REDIS_PORT=6379

# --- MinIO (test-case object storage, T3-8; problem-service and judge-worker use it) ---
# The root account stays with minio and minio-init. minio-init (minio/minio-init.sh) creates the two service users from
# the keys below: problem-service reads, writes and deletes test cases, the worker only reads them. Services reach MinIO
# at https://minio:9000 (set in docker-compose.yml). Secrets: at least 8 characters, e.g. `openssl rand -hex 24`.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PROBLEM_ACCESS_KEY=oj-problem
MINIO_PROBLEM_SECRET_KEY=change-me-problem
MINIO_WORKER_ACCESS_KEY=oj-worker
MINIO_WORKER_SECRET_KEY=change-me-worker
MINIO_BUCKET=test-cases

# ---- the HTTPS edge (sub-project 10) ----
# The public host name: Caddy's site address and the gateway's CORS origin https://<host>. Optional, default localhost.
# The edge certificate must name it: issue it with the same value (OJ_PUBLIC_HOST=<host> pki/pki.sh issue-all).
# OJ_PUBLIC_HOST=localhost
