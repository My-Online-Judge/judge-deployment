# ============================================================================
# Template for judge-deployment/.env — copy to .env and fill in the secrets.
#   cp .env.example .env
# Container-network addresses (kafka:29092) — keep as-is unless you rename services.
# Each service's database settings live in its own file: .env.identity, .env.problem, .env.submission
# (see the matching .example files).
# ============================================================================

# ---- spring profile (submission-service, api-gateway) ----
# "prod" runs submission-service against Postgres with ddl-auto=validate and swagger disabled.
SPRING_PROFILES_ACTIVE=prod

# ---- shared judge-server auth/token (api, worker, judge-server all agree) ----
# Required: the worker refuses to start without it. The sandboxes' URLs are fixed in docker-compose.yml (judge-worker's
# JUDGE_SERVER_URL, https: the worker presents its certificate).
JUDGE_SERVER_TOKEN=change-me

# ---- kafka (internal KRaft listener) ----
KAFKA_BROKERS=kafka:29092

# ---- redis (verdict SSE fan-out across submission-service instances) ----
REDIS_HOST=redis
REDIS_PORT=6379

# --- MinIO (test-case object storage, T3-8; problem-service and judge-worker use it) ---
# The root account stays with minio and minio-init. minio-init (minio/minio-init.sh) creates the two service users from
# the keys below: problem-service reads, writes and deletes test cases, the worker only reads them. Services reach MinIO
# at https://minio:9000 (set in docker-compose.yml). Secrets: at least 8 characters, e.g. `openssl rand -hex 24`.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_PROBLEM_ACCESS_KEY=oj-problem
MINIO_PROBLEM_SECRET_KEY=change-me-problem
MINIO_WORKER_ACCESS_KEY=oj-worker
MINIO_WORKER_SECRET_KEY=change-me-worker
MINIO_BUCKET=test-cases

# ---- the HTTPS edge (sub-project 10) ----
# The public host name: Caddy's site address and the gateway's CORS origin https://<host>. Optional, default localhost.
# The edge certificate must name it: issue it with the same value (OJ_PUBLIC_HOST=<host> pki/pki.sh issue-all).
# OJ_PUBLIC_HOST=localhost

# ---- Postgres exporters (sp12) ----
# The password of the read-only role oj_monitor (pg_monitor) in each database, which the three postgres-exporters log
# in with (scram plus their client certificate). migrations/sp12-env.sh generates it; migrations/sp12-pg-monitor.sh
# creates the role. Required: compose refuses to start without it.
PG_MONITOR_PASSWORD=change-me

# ---- images (sp12) ----
# Each built service is ${OJ_REGISTRY}/<name>:<tag>. Optional; the defaults are shown. `docker compose build` tags the
# local build with that name, `up --no-build` runs it, `pull` fetches what CI pushed. A tag is a commit sha or main.
# OJ_REGISTRY=ghcr.io/my-online-judge
# OJ_TAG=main                 # the tag for every image below that has no tag of its own
# OJ_IDENTITY_TAG=main        # oj-identity-service
# OJ_PROBLEM_TAG=main         # oj-problem-service
# OJ_SUBMISSION_TAG=main      # oj-submission-service
# OJ_GATEWAY_TAG=main         # oj-api-gateway
# OJ_WORKER_TAG=main          # judge-worker
# OJ_PORTAL_TAG=main          # judge-portal

# ---- alerting (sp12) ----
# Alerts always show in Alertmanager (http://127.0.0.1:9093). Set BOTH to also send them to Telegram (alertmanager/render.sh):
# the bot token from @BotFather, and the numeric id of the chat the bot may write to (a group id starts with -).
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=

# ---- K3s backup (k3s/base/backup, read by k3s/scripts/env-to-secrets.sh; compose's backup/backup.sh does not use these) ----
# The nightly backup's restic repository and its password. The repository must NOT be on the server's disk: an S3 or B2 bucket
# (s3:s3.amazonaws.com/<bucket>/oj, b2:<bucket>:oj) or sftp:user@host:/path, with the matching keys below. Keep a copy of the
# password somewhere else: without it the snapshots are unreadable. Without both the nightly job stops with a message.
# RESTIC_REPOSITORY=
# RESTIC_PASSWORD=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=

# ---- dashboards (sp12) ----
# Grafana admin password (http://127.0.0.1:3000, user admin). It takes effect ONLY when the grafanadata volume is first
# created; to change it later see README "Dashboards" (grafana cli admin reset-admin-password, typed at the prompt).
GRAFANA_ADMIN_PASSWORD=change-me

# ---- root admin (identity) ----
# The identity V2 migration seeds `admin` with a published default password; the DefaultAdminPassword alert fires until
# it is changed (PUT /api/v1/users/me/password). Keep the real one here so operators and tools can read it without
# printing it, e.g. `OJ_PASSWORD=$(grep '^OJ_ADMIN_PASSWORD=' .env | cut -d= -f2-) python3 seed/problems/load.py`.
# Compose does not read this variable.
# OJ_ADMIN_PASSWORD=
