# ============================================================================
# Template for judge-deployment/.env — copy to .env and fill in the secrets.
#   cp .env.example .env
# Container-network addresses (db / kafka:29092 / judge-server) — keep as-is unless
# you rename services. identity-service reads .env.identity instead (see .env.identity.example),
# problem-db and problem-service read .env.problem (see .env.problem.example).
# ============================================================================

# ---- spring profile (judge-api, api-gateway) ----
# "prod" runs judge-api against Postgres with ddl-auto=validate and swagger disabled.
SPRING_PROFILES_ACTIVE=prod

# ---- shared judge-server auth/token (api, worker, judge-server all agree) ----
JUDGE_SERVER_TOKEN=change-me
# The worker accepts a COMMA-SEPARATED list of judge-server URLs and round-robins across them
# with failover (skips a dead sandbox / 5xx and tries the next). To run more than one sandbox,
# add another judge-server service and list both, e.g.:
#   JUDGE_SERVER_URL=http://judge-server:8080,http://judge-server-2:8080
JUDGE_SERVER_URL=http://judge-server:8080,http://judge-server-2:8080

# ---- database ----
DATABASE_URL=jdbc:postgresql://db:5432/my_oj
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me
DATABASE_NAME=my_oj

# ---- problem-service's internal gRPC API (judge-api calls, problem-service checks) ----
# 32+ characters; generate with `openssl rand -hex 32` (migrations/sp2-env.sh adds one).
PROBLEM_RPC_TOKEN=change-me-to-64-hex-characters

# ---- kafka (internal KRaft listener) ----
KAFKA_BROKERS=kafka:29092

# ---- redis (verdict SSE fan-out across judge-api instances) ----
REDIS_HOST=redis
REDIS_PORT=6379

# --- MinIO (test-case object storage, T3-8; problem-service and judge-worker use it) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=test-cases
