# ============================================================================
# Template for judge-deployment/.env.problem — read ONLY by problem-db and problem-service.
#   cp .env.problem.example .env.problem && chmod 600 .env.problem
# (migrations/sp2-env.sh writes it with a generated password, and adds PROBLEM_RPC_TOKEN to .env.)
# problem-service gets MinIO, Kafka, the JWKS URI and PROBLEM_RPC_TOKEN through docker-compose.yml.
# ============================================================================

# ---- problem-db ----
POSTGRES_DB=problem
POSTGRES_USER=problem
POSTGRES_PASSWORD=change-me

# ---- problem-service: its database (must match the three above) ----
DATABASE_URL=jdbc:postgresql://problem-db:5432/problem
DATABASE_USERNAME=problem
DATABASE_PASSWORD=change-me
SPRING_PROFILES_ACTIVE=prod
