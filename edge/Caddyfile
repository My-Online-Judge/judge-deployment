# The HTTPS edge (sub-project 10): the stack's only public listener (80, 443). One origin for the browser:
# /api/* goes to api-gateway:8000, everything else to judge-portal:443, both over mutual TLS with the edge's certificate
# (the gateway and the portal answer no other). Port 80 only redirects to https.
# The site certificate is the edge leaf (pki/identities.txt: SAN ${OJ_PUBLIC_HOST} and edge), signed by the private CA.
# No trusted_proxies: Caddy discards a client's X-Forwarded-For and writes the client's address, which the gateway
# trusts as the first hop (its tls profile, oj.gateway.edge.trust-forwarded-for).
{$OJ_PUBLIC_HOST:localhost}, edge {
	tls /etc/oj/tls/tls.crt /etc/oj/tls/tls.key
	encode gzip
	# Browser-facing security headers on every response (sub-project 15). The CSP lets the portal run only its own files:
	# no inline script (the first-paint theme script is /theme-init.js), styles may be inline (Vue :style and KaTeX position
	# glyphs with style attributes), images from any https host (statements, Google avatars) or data:, KaTeX fonts, Monaco's
	# workers (blob: for the ones it spawns itself), and fetch/SSE to this origin only. Nothing may frame the page (the admin
	# console would be clickjackable), and a form posts only back here.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
	# No HSTS for localhost: browsers pin it per host, not per port, and would force https on every other local port
	# (a dev server on http://localhost:5173) for a year.
	@hsts not host localhost 127.0.0.1
	header @hsts Strict-Transport-Security "max-age=31536000"
	handle /api/* {
		# A source is at most 10 KiB and every other API body is small, so 1 MB covers them and refuses a bigger body before
		# the gateway reads it. The one exception is problem-service's multipart uploads (a test-case pair, a checker, a
		# problem package: spring.servlet.multipart allows 50 MB per file, 55 MB per request), all under /api/v1/problems:
		# they get 56 MiB, a little above that limit, so problem-service still answers its own error for an oversize one.
		@problemUploads path /api/v1/problems/*
		@otherBodies not path /api/v1/problems/*
		request_body @problemUploads {
			max_size 56MiB
		}
		request_body @otherBodies {
			max_size 1MB
		}
		reverse_proxy https://api-gateway:8000 {
			flush_interval -1
			transport http {
				tls_client_auth /etc/oj/tls/tls.crt /etc/oj/tls/tls.key
				tls_trust_pool file /etc/oj/tls/ca.crt
				tls_server_name api-gateway
			}
		}
	}
	handle {
		reverse_proxy https://judge-portal:443 {
			transport http {
				tls_client_auth /etc/oj/tls/tls.crt /etc/oj/tls/tls.key
				tls_trust_pool file /etc/oj/tls/ca.crt
				tls_server_name judge-portal
			}
		}
	}
}
