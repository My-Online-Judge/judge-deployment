# The two values to set before applying overlays/vps (the placeholders end in .invalid, which Let's Encrypt refuses, so an
# unedited file cannot get a certificate). They are copied into the gateway's CORS origin (OJ_PUBLIC_HOST, as compose's
# ${OJ_PUBLIC_HOST}), the certificate edge-tls and the issuer letsencrypt.
OJ_PUBLIC_HOST=oj.example.invalid
ACME_EMAIL=ops@example.invalid
