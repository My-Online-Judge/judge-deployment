# ============================================================================
# Template for judge-deployment/.env.submission — read ONLY by submission-db and submission-service.
#   cp .env.submission.example .env.submission && chmod 600 .env.submission
# (migrations/sp3-env.sh create writes it with a generated password.)
# submission-service gets Kafka, Redis, the judge-server token, problem-service's gRPC address and service token
# and the JWKS URI through docker-compose.yml.
# ============================================================================

# ---- submission-db ----
POSTGRES_DB=submission
POSTGRES_USER=submission
POSTGRES_PASSWORD=change-me

# ---- submission-service: its database (must match the three above) ----
DATABASE_URL=jdbc:postgresql://submission-db:5432/submission
DATABASE_USERNAME=submission
DATABASE_PASSWORD=change-me
SPRING_PROFILES_ACTIVE=prod
